{
  "name": "mhws-in-json-web",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "vue-tsc --noEmit",
    "build": "npm run typecheck && vite build && vite build --ssr src/entry-server.ts --outDir ../.tmp/web-ssr --emptyOutDir && node --experimental-strip-types scripts/prerender.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "elkjs": "0.11.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "typescript": "~5.9.3",
    "vite": "^8.3.5",
    "vue-tsc": "^3.3.14"
  }
}
